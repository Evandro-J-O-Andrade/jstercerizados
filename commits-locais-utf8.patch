diff --git a/src/shell/AdminModuleLayout.tsx b/src/shell/AdminModuleLayout.tsx
new file mode 100644
index 0000000..14080e7
--- /dev/null
+++ b/src/shell/AdminModuleLayout.tsx
@@ -0,0 +1,157 @@
+import { type ReactNode } from 'react';
+import { NavLink, useLocation } from 'react-router-dom';
+import { ChevronRight, Home, Clock, LayoutDashboard } from 'lucide-react';
+import { cn } from '@/utils';
+import { getAvailableFeatures } from '@/platform/modules';
+import { useAccount } from '@/platform/context';
+import type { Permission } from '@/types/auth';
+import type { ModuleDefinition } from '@/platform/modules';
+
+interface BreadcrumbItem {
+  label: string;
+  href?: string;
+}
+
+interface AdminModuleLayoutProps {
+  module: ModuleDefinition;
+  children: ReactNode;
+  className?: string;
+}
+
+function AdminModuleBreadcrumb({
+  breadcrumbItems,
+  homeRoute = '/dashboard',
+}: {
+  breadcrumbItems: BreadcrumbItem[];
+  homeRoute?: string;
+}) {
+  if (breadcrumbItems.length === 0) return null;
+
+  return (
+    <nav aria-label="Breadcrumb" className="mb-6">
+      <ol className="text-muted-foreground flex items-center gap-2 text-sm">
+        <li>
+          <NavLink
+            to={homeRoute}
+            className="hover:text-foreground transition-colors"
+          >
+            <Home className="h-4 w-4" />
+          </NavLink>
+        </li>
+        {breadcrumbItems.map((item, index) => (
+          <li key={index} className="flex items-center gap-2">
+            <ChevronRight className="h-4 w-4" />
+            {item.href ? (
+              <NavLink
+                to={item.href}
+                className="hover:text-foreground transition-colors"
+              >
+                {item.label}
+              </NavLink>
+            ) : (
+              <span className="text-foreground font-medium">{item.label}</span>
+            )}
+          </li>
+        ))}
+      </ol>
+    </nav>
+  );
+}
+
+function AdminModuleSidebar({
+  module,
+  permissions,
+}: {
+  module: ModuleDefinition;
+  permissions: Permission[];
+}) {
+  const location = useLocation();
+  const features = getAvailableFeatures(permissions, module, module.scope);
+
+  if (!features.length) return null;
+
+  return (
+    <aside className="bg-card border-border w-64 shrink-0 border-r">
+      <nav className="p-3" aria-label={`${module.title} navigation`}>
+        <p className="text-muted-foreground mb-2 px-2 text-xs font-semibold tracking-wider uppercase">
+          {module.title}
+        </p>
+        <div className="space-y-0.5">
+          {features.map((feature) => {
+            const isActive =
+              location.pathname === feature.route ||
+              location.pathname.startsWith(`${feature.route}/`);
+            const isComingSoon = feature.implementationStatus === 'coming_soon';
+
+            return (
+              <NavLink
+                key={feature.id}
+                to={feature.route}
+                className={cn(
+                  'flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors',
+                  isComingSoon
+                    ? 'text-muted-foreground'
+                    : isActive
+                      ? 'bg-primary/10 text-primary'
+                      : 'text-muted-foreground hover:bg-muted hover:text-foreground',
+                )}
+              >
+                <span className="flex-1">{feature.title}</span>
+                {isComingSoon ? (
+                  <Clock className="text-muted-foreground h-3.5 w-3.5" />
+                ) : isActive ? (
+                  <ChevronRight className="ml-auto h-4 w-4" />
+                ) : null}
+              </NavLink>
+            );
+          })}
+        </div>
+      </nav>
+    </aside>
+  );
+}
+
+export function AdminModuleLayout({
+  module,
+  children,
+  className,
+}: AdminModuleLayoutProps) {
+  const { activePermissions } = useAccount();
+  const features = getAvailableFeatures(
+    activePermissions,
+    module,
+    module.scope,
+  );
+
+  const showSidebar = features.some((f) => f.route !== module.route);
+
+  return (
+    <div className={cn('flex flex-col', className)}>
+      <AdminModuleBreadcrumb breadcrumbItems={[{ label: module.title }]} />
+      <div className="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
+        <div className="flex items-start gap-4">
+          <div className="bg-primary/10 text-primary flex h-12 w-12 shrink-0 items-center justify-center rounded-xl">
+            <LayoutDashboard className="h-6 w-6" />
+          </div>
+          <div>
+            <h1 className="text-foreground text-2xl font-bold sm:text-3xl">
+              {module.title}
+            </h1>
+            {module.description && (
+              <p className="text-muted-foreground mt-1 text-sm sm:text-base">
+                {module.description}
+              </p>
+            )}
+          </div>
+        </div>
+      </div>
+
+      <div className="flex min-h-0 flex-1 gap-6">
+        {showSidebar && (
+          <AdminModuleSidebar module={module} permissions={activePermissions} />
+        )}
+        <div className="min-w-0 flex-1 p-6">{children}</div>
+      </div>
+    </div>
+  );
+}
diff --git a/src/shell/AdminShell.tsx b/src/shell/AdminShell.tsx
new file mode 100644
index 0000000..cb0e73f
--- /dev/null
+++ b/src/shell/AdminShell.tsx
@@ -0,0 +1,67 @@
+import { type ReactNode, useState, useLayoutEffect } from 'react';
+import { Outlet } from 'react-router-dom';
+import { AccountProvider } from '@/contexts/AccountContext';
+import { ModuleProvider } from '@/contexts/ModuleContext';
+import { AdminSidebar } from './AdminSidebar';
+import { AdminHeader } from './AdminHeader';
+
+interface AdminShellProps {
+  moduleTitle?: string;
+  children?: ReactNode;
+}
+
+function AdminShellInner({ moduleTitle, children }: AdminShellProps) {
+  const [sidebarOpen, setSidebarOpen] = useState(false);
+
+  useLayoutEffect(() => {
+    const previousBodyOverflow = document.body.style.overflow;
+    const previousHtmlOverflow = document.documentElement.style.overflow;
+
+    document.body.style.overflow = 'hidden';
+    document.documentElement.style.overflow = 'hidden';
+
+    return () => {
+      document.body.style.overflow = previousBodyOverflow;
+      document.documentElement.style.overflow = previousHtmlOverflow;
+    };
+  }, []);
+
+  const currentModuleTitle = moduleTitle || 'J&S Empregos';
+  const content = children ?? <Outlet />;
+
+  return (
+    <div className="bg-muted/30 flex h-dvh w-full flex-row overflow-hidden">
+      <AdminSidebar
+        isOpen={sidebarOpen}
+        onClose={() => setSidebarOpen(false)}
+        onNavigate={() => setSidebarOpen(false)}
+      />
+
+      <div className="flex min-h-0 min-w-0 flex-1 flex-col">
+        <AdminHeader
+          onMenuClick={() => setSidebarOpen(true)}
+          moduleTitle={currentModuleTitle}
+          className="shrink-0"
+        />
+
+        <div className="flex min-h-0 flex-1 flex-col overflow-hidden">
+          <main className="flex min-h-0 flex-col">
+            <div className="mx-auto flex min-h-0 max-w-[1920px] flex-1 flex-col overflow-y-auto px-4 py-6 sm:px-6 lg:px-8 xl:max-w-[2200px] xl:px-10">
+              {content}
+            </div>
+          </main>
+        </div>
+      </div>
+    </div>
+  );
+}
+
+export function AdminShell({ moduleTitle, children }: AdminShellProps) {
+  return (
+    <AccountProvider>
+      <ModuleProvider>
+        <AdminShellInner moduleTitle={moduleTitle} children={children} />
+      </ModuleProvider>
+    </AccountProvider>
+  );
+}
diff --git a/src/shell/AdminSidebar.tsx b/src/shell/AdminSidebar.tsx
new file mode 100644
index 0000000..87253ee
--- /dev/null
+++ b/src/shell/AdminSidebar.tsx
@@ -0,0 +1,381 @@
+import { useState, useMemo } from 'react';
+import { NavLink, useLocation, useNavigate } from 'react-router-dom';
+import {
+  Shield,
+  Globe,
+  PanelLeftClose,
+  PanelLeftOpen,
+  LayoutDashboard,
+} from 'lucide-react';
+import { motion, AnimatePresence } from 'framer-motion';
+import { cn } from '@/utils';
+import { Button } from '@/components/ui/Button';
+import { Card } from '@/components/ui/Card';
+import { useAuth } from '@/contexts/AuthContext';
+import { useAccount } from '@/contexts/AccountContext';
+import { formatRoleLabel } from '@/contexts/UserIdentity';
+import { cellRegistry } from '@/core/registry/CellRegistryContract';
+import type { CellContract } from '@/core/types';
+import { COMPANY } from '@/config';
+
+interface AdminSidebarProps {
+  isOpen: boolean;
+  onClose: () => void;
+  onNavigate?: () => void;
+}
+
+export function AdminSidebar({
+  isOpen,
+  onClose,
+  onNavigate,
+}: AdminSidebarProps) {
+  const location = useLocation();
+  const navigate = useNavigate();
+  const { roles } = useAuth();
+  const { identity, availableMemberships, activeTenantId, switchAccount } =
+    useAccount();
+
+  const [collapsed, setCollapsed] = useState(false);
+  const [switchOpen, setSwitchOpen] = useState(false);
+  const [expandedCells, setExpandedCells] = useState<string[]>([]);
+
+  const enabledCells = useMemo<CellContract[]>(() => {
+    return cellRegistry.getEnabled().map((e) => e.cell);
+  }, []);
+
+  const now = new Date();
+  const dateLabel = now.toLocaleDateString('pt-BR', {
+    day: '2-digit',
+    month: 'long',
+    year: 'numeric',
+  });
+  const timeLabel = now.toLocaleTimeString('pt-BR', {
+    hour: '2-digit',
+    minute: '2-digit',
+  });
+  const displayName = identity.displayName;
+  const roleLabel = identity.roleLabel;
+
+  const getCellBaseRoute = (cellId: string) => {
+    return cellId === 'candidato' ? '/candidato' : `/dashboard/${cellId}`;
+  };
+
+  const getRoutePath = (cellId: string, routePath: string) => {
+    const base = getCellBaseRoute(cellId);
+    if (!routePath) return base;
+    const cleanRoute = routePath.startsWith('/') ? routePath : `/${routePath}`;
+    return `${base}${cleanRoute}`;
+  };
+
+  const isExactMatch = (targetPath: string, pathname: string) =>
+    pathname === targetPath;
+
+  const isCellSelected = (cell: CellContract) => {
+    const base = getCellBaseRoute(cell.id);
+    return location.pathname.startsWith(base);
+  };
+
+  const handleNavigate = (href: string) => {
+    setExpandedCells([]);
+    navigate(href);
+    onNavigate?.();
+    onClose();
+  };
+
+  const handleSwitchAccount = (tenantId: string) => {
+    switchAccount(tenantId);
+    setSwitchOpen(false);
+    handleNavigate('/dashboard');
+  };
+
+  const sidebarWidth = collapsed ? 'w-16' : 'w-72';
+
+  return (
+    <>
+      {isOpen && (
+        <div
+          className="bg-background/60 fixed inset-0 z-30 lg:hidden"
+          onClick={onClose}
+        />
+      )}
+      <aside
+        className={cn(
+          'bg-card border-border fixed top-0 left-0 z-40 h-full shrink-0 transform border-r transition-all duration-200 lg:relative lg:top-auto lg:left-auto lg:z-auto lg:translate-x-0',
+          sidebarWidth,
+          isOpen ? 'translate-x-0' : '-translate-x-full',
+        )}
+      >
+        <div className="flex h-full flex-col">
+          <div className="flex items-center justify-between border-b p-4">
+            {!collapsed && (
+              <div className="flex items-center gap-2">
+                <Shield className="text-primary h-6 w-6" />
+                <div className="min-w-0">
+                  <p className="text-foreground truncate text-sm font-semibold">
+                    {COMPANY.name}
+                  </p>
+                  <p className="text-muted-foreground truncate text-xs">
+                    {enabledCells.length} módulos ativos
+                  </p>
+                </div>
+              </div>
+            )}
+            {collapsed && (
+              <div className="mx-auto">
+                <Shield className="text-primary h-6 w-6" />
+              </div>
+            )}
+            <div className="flex items-center gap-1">
+              <Button
+                variant="ghost"
+                size="sm"
+                onClick={() => setCollapsed((prev) => !prev)}
+                aria-label={collapsed ? 'Expandir menu' : 'Recolher menu'}
+                className="hidden lg:flex"
+              >
+                {collapsed ? (
+                  <PanelLeftOpen className="h-5 w-5" />
+                ) : (
+                  <PanelLeftClose className="h-5 w-5" />
+                )}
+              </Button>
+              <Button
+                variant="ghost"
+                size="sm"
+                onClick={onClose}
+                aria-label="Fechar menu"
+                className="lg:hidden"
+              >
+                <Globe className="h-5 w-5" />
+              </Button>
+            </div>
+          </div>
+
+          <nav
+            className="flex-1 space-y-1 overflow-y-auto p-2"
+            aria-label="Módulos"
+          >
+            {!collapsed && (
+              <div className="space-y-3">
+                <div className="flex items-center gap-2 px-2 py-2">
+                  <span className="bg-primary/10 text-primary rounded-lg p-1.5">
+                    <LayoutDashboard className="h-4 w-4" />
+                  </span>
+                  <span className="text-muted-foreground flex-1 truncate text-xs font-semibold tracking-wider uppercase">
+                    Módulos
+                  </span>
+                </div>
+                <div className="space-y-1">
+                  {enabledCells.map((cell) => {
+                    const cellSelected = isCellSelected(cell);
+                    const cellExpanded = expandedCells.includes(cell.id);
+
+                    return (
+                      <div key={cell.id}>
+                        <button
+                          type="button"
+                          onClick={() => {
+                            if (collapsed) {
+                              handleNavigate(getCellBaseRoute(cell.id));
+                              return;
+                            }
+                            if (cellExpanded) {
+                              setExpandedCells((prev) =>
+                                prev.filter((id) => id !== cell.id),
+                              );
+                            } else {
+                              setExpandedCells([cell.id]);
+                            }
+                          }}
+                          aria-expanded={cellExpanded}
+                          className={cn(
+                            'flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition-colors',
+                            cellSelected
+                              ? 'bg-primary/10 text-primary'
+                              : 'text-muted-foreground hover:bg-muted hover:text-foreground',
+                            collapsed && 'justify-center px-2',
+                          )}
+                        >
+                          {!collapsed && (
+                            <span className="flex-1 truncate text-left">
+                              {cell.name}
+                            </span>
+                          )}
+                          {!collapsed && (
+                            <span className="text-xs">
+                              {cellExpanded ? '▼' : '▶'}
+                            </span>
+                          )}
+                        </button>
+                        {cellExpanded && (
+                          <div className="mt-1 ml-4 space-y-0.5 border-l pl-3">
+                            {cell.routes.map((route) => {
+                              const targetPath = getRoutePath(
+                                cell.id,
+                                route.path,
+                              );
+                              const active = isExactMatch(
+                                targetPath,
+                                location.pathname,
+                              );
+
+                              return (
+                                <NavLink
+                                  key={route.path}
+                                  to={targetPath}
+                                  end
+                                  onClick={() => handleNavigate(targetPath)}
+                                  className={cn(
+                                    'block rounded-lg px-3 py-1.5 text-sm transition-colors',
+                                    collapsed && 'px-2',
+                                    active
+                                      ? 'bg-primary/10 text-primary font-medium'
+                                      : 'text-muted-foreground hover:bg-muted hover:text-foreground',
+                                  )}
+                                >
+                                  {!collapsed && route.label}
+                                </NavLink>
+                              );
+                            })}
+                          </div>
+                        )}
+                      </div>
+                    );
+                  })}
+                </div>
+              </div>
+            )}
+
+            <div className="border-border border-t p-2">
+              {!collapsed ? (
+                <div className="mb-3 flex items-center gap-3 px-2">
+                  <div className="bg-primary/10 text-primary flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold">
+                    {displayName.charAt(0).toUpperCase()}
+                  </div>
+                  <div className="min-w-0 flex-1">
+                    <p className="text-foreground truncate text-sm font-medium">
+                      {displayName}
+                    </p>
+                    <p className="text-muted-foreground truncate text-xs">
+                      {roleLabel}
+                    </p>
+                  </div>
+                </div>
+              ) : (
+                <div className="mb-3 flex justify-center">
+                  <div className="bg-primary/10 text-primary flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold">
+                    {displayName.charAt(0).toUpperCase()}
+                  </div>
+                </div>
+              )}
+              {!collapsed && (
+                <div className="text-muted-foreground mb-3 px-2 text-xs">
+                  {dateLabel} • {timeLabel}
+                </div>
+              )}
+              <div className="space-y-0.5">
+                <Button
+                  variant="ghost"
+                  size="sm"
+                  onClick={() => handleNavigate('/')}
+                  className={cn(
+                    'text-muted-foreground hover:text-foreground',
+                    collapsed
+                      ? 'flex w-full items-center justify-center'
+                      : 'flex w-full items-center justify-start gap-2',
+                  )}
+                >
+                  <Globe className="h-4 w-4" />
+                  {!collapsed && <span>Voltar para o site</span>}
+                </Button>
+              </div>
+            </div>
+          </nav>
+        </div>
+      </aside>
+
+      <AnimatePresence>
+        {switchOpen && (
+          <motion.div
+            initial={{ opacity: 0 }}
+            animate={{ opacity: 1 }}
+            exit={{ opacity: 0 }}
+            className="bg-background/60 fixed inset-0 z-[60] flex items-center justify-center backdrop-blur-sm"
+          >
+            <motion.div
+              initial={{ opacity: 0, y: 20 }}
+              animate={{ opacity: 1, y: 0 }}
+              exit={{ opacity: 0, y: 20 }}
+              className="mx-4 w-full max-w-lg"
+            >
+              <Card variant="default" className="p-6 shadow-xl">
+                <div className="mb-4 flex items-center justify-between">
+                  <h2 className="text-foreground text-lg font-semibold">
+                    Escolha seu acesso
+                  </h2>
+                  <Button
+                    variant="ghost"
+                    size="sm"
